{
  "name": "apropos",
  "version": "0.1.0",
  "description": "Transparente KI-Research: local-first Desktop-App mit Provenienz-Erzwingung, Cursor-Agent und Schreibpaket für Easy Writing und Penwright.",
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "npm run abi:electron && electron-vite dev",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "mcp:stdio": "ELECTRON_RUN_AS_NODE=1 electron out/main/stdio.js",
    "abi:node": "npm rebuild better-sqlite3",
    "abi:electron": "electron-rebuild -f -w better-sqlite3",
    "mcp:stdio:dev": "tsx src/main/mcp/stdio-entry.ts",
    "lit:check": "tsx scripts/lit-check.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.10.0",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "material-symbols": "^0.31.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^1.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.0",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
